# ===== OKX AI Builder 归因(核心,申请 AI Builder Program 后从控制台拿到) =====
# 1-16 位字母数字,下单命令会强制注入 --aiBuilderCode。留空则下单不带归因(拿不到返佣)。
OKX_AI_BUILDER_CODE=YOUR_16_CHAR_CODE

# ===== 运行模式 =====
OKX_DEMO=true        # true=模拟盘(默认,先跑这个) / false=实盘
DRY_RUN=true         # true=只打日志不真下单 / false=真下单

# ===== 监控合约(逗号分隔,instId 全大写) =====
SYMBOLS=BTC-USDT-SWAP,ETH-USDT-SWAP,SOL-USDT-SWAP
# 交易白名单(空=全部 SYMBOLS 可交易;填了则只交易这些)
TRADE_WHITELIST=

# ===== 均线/拐点参数(沿用斜率归零系统实测值,别凭感觉改) =====
MA_MID=13
MA_LONG=35
TURN_LOOKBACK=5
TURN_MIN=0.08
TURN_BAND=0.03

# ===== 下单/仓位/风控 =====
MARGIN_PER_TRADE=100   # 每单固定保证金(USDT)
LEVERAGE=3             # 杠杆倍数
TD_MODE=cross          # cross 全仓 / isolated 逐仓
SL_PCT=0.02            # 硬止损百分比(2%)
TP_PCT=0               # 止盈百分比(0=关闭,让趋势跑)
TRAIL_PCT=0.015        # 追踪止损回撤百分比(1.5%,从极值回撤此幅度离场)
REVERSE_ON_SIGNAL=false  # 反向信号是否反手(默认否:只平仓)
MAX_OPEN_POSITIONS=3   # 同时最大持仓合约数
MAX_TOTAL_LOSS=300     # 总亏损熔断阈值(USDT)

# ===== 趋势过滤(大级别方向,只做顺趋势) =====
TREND_FILTER=true      # 是否启用趋势过滤
TREND_BAR=1H           # 过滤用的大级别周期
TREND_THRESHOLD=0.02   # 大级别 MA35 斜率阈值(%):|斜率|>此值才视为有趋势

# ===== 扫描 =====
SCAN_INTERVAL=10
CANDLE_LIMIT=60
HISTORY_DAYS=3

# ===== 钉钉(可选,不填则只打日志) =====
DING_WEBHOOK=
DING_KEYWORD=均线拐点交易

# ===== 网络 =====
BASE_URL=https://www.okx.com
HTTP_PROXY=http://127.0.0.1:7890
HTTPS_PROXY=http://127.0.0.1:7890
